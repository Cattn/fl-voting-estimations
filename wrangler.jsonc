{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fl-ev",
	"account_id": "fcbd3526f9033b92ddbf3725c0ba340b",
	"main": "worker.js",
	"workers_dev": false,
	"routes": [{ "pattern": "fl.cattn.dev", "custom_domain": true }],
	"triggers": { "crons": ["*/3 * * * *"] },
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "ELECTION_HISTORY",
			"database_name": "fl-ev-history",
			"database_id": "f0d87ca0-be5c-425c-a97a-b2347e87c849"
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"kv_namespaces": [
		{
			"binding": "FEED_CACHE",
			"id": "4c94b4d74f484d1497e5332979cabb81"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 0.1
		},
		"traces": {
			"enabled": false
		}
	}
}
